PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Set MONGODB_URI to your local or MongoDB Atlas connection string.
# If left empty or connection fails in development/test, SkillForge will automatically initialize an in-memory MongoDB instance.
MONGODB_URI=mongodb://localhost:27017/skillforge

# JWT Authentication
JWT_SECRET=skillforge_super_secure_jwt_secret_key_2026_exam_portal
JWT_EXPIRES_IN=7d

# Code Execution Service (Judge0 Compatible API)
# Leave empty if not configured; the portal will clearly report execution service status
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Assessment & Campus Timezone Configuration
CAMPUS_TIMEZONE=Asia/Kolkata
